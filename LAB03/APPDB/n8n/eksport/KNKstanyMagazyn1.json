      "id": "KNKstanyMagazyn1-03",
      "name": "API WooCommerce: produkty",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        200
      ],
      "credentials": {
        "wooCommerceApi": {
          "id": "KNKwooCommerce01",
          "name": "WooCommerce KawaNaKlik (test)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Produkty z włączonym stanem magazynowym i stanem ≤ progu.\nconst cfg = $('Konfiguracja').first().json;\nconst all = $input.all().map(i => i.json);\nconst low = all\n  .filter(p => p.manage_stock && Number(p.stock_quantity) <= cfg.prog)\n  .sort((a, b) => a.stock_quantity - b.stock_quantity)\n  .map(p => ({ nazwa: p.name, sku: p.sku, stan: Number(p.stock_quantity) }));\nconst rows = low.map(p => `<tr><td>${p.nazwa}</td><td>${p.sku}</td><td align=\"right\"><b>${p.stan}</b></td></tr>`).join('');\nreturn [{ json: {\n  sprawdzono: all.length, prog: cfg.prog, liczba: low.length, produkty: low,\n  tekst: low.map(p => `• ${p.nazwa} (${p.sku}): ${p.stan} szt.`).join('\\n'),\n  html: `<p>Kontrola z ${$now.toFormat('dd.LL.yyyy HH:mm')}: ${low.length} z ${all.length} produktów ma stan ≤ ${cfg.prog} szt.</p>` +\n        `<table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\"><tr><th>Produkt</th><th>SKU</th><th>Stan</th></tr>${rows}</table>`,\n} }];"
      },
      "id": "KNKstanyMagazyn1-04",
      "name": "Niskie stany",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ]
    },
    {
