        200
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.api }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "wooCommerceApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
